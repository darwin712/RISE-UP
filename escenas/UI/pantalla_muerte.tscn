[sub_resource type="Shader" id="Shader_desaturar"]
code = "shader_type canvas_item;

uniform sampler2D screen_texture : hint_screen_texture, filter_nearest;

void fragment() {
	vec4 escena = texture(screen_texture, SCREEN_UV);
	float gris = dot(escena.rgb, vec3(0.299, 0.587, 0.114));
	vec3 apagado = mix(escena.rgb, vec3(gris), 0.82);
	vec3 oscuro = mix(apagado, vec3(0.025, 0.030, 0.055), 0.62);
	COLOR = vec4(oscuro, 1.0);
}
"

